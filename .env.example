# ~/.q402/mcp.env — Q402 MCP server configuration
# Copy this file to ~/.q402/mcp.env and fill in your values.
# chmod 600 ~/.q402/mcp.env

# ── API key (pick one or both for auto-routing) ──
Q402_TRIAL_API_KEY=          # Free Trial, BNB (permanent) + Base (permanent) + Mantle limited-time (from /event); Avalanche trial has ended
Q402_MULTICHAIN_API_KEY=     # Paid Multichain, all 12 chains (from /payment)

# ── Signing path — pick ONE of Mode A / B / C ──
# Mode A: your MetaMask EOA's hex private key.
Q402_PRIVATE_KEY=

# Mode B: exported Agent Wallet pk from the dashboard.
Q402_AGENTIC_PRIVATE_KEY=

# Mode C: no PK needed — leave both PK lines blank.
# Optional: pin one of your Agent Wallets when you have multiple (max 10).
# Q402_AGENT_WALLET_ADDRESS=0x...

# Live mode switch (0 = sandbox, 1 = real on-chain payments):
Q402_ENABLE_REAL_PAYMENTS=1

# Default Q402 deployment. Only change for self-hosted.
Q402_RELAY_BASE_URL=https://q402.quackai.ai/api

# ── Safety guards ──
Q402_MAX_AMOUNT_PER_CALL=200
# Q402_ALLOWED_RECIPIENTS=0xabc...,0xdef...
# Q402_X402_SESSION_CAP_USD=5

# ── x402 attribution ──
# Base Builder Code for on-chain ERC-8021 attribution on every q402_x402_fetch payment.
# Set to your registered Builder Code (1–32 lowercase letters/numbers/underscores).
Q402_BUILDER_CODE=bc_fu2v7kgf
